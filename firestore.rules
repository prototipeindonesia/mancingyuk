rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // USERS - Setiap user bisa baca/tulis profil sendiri
    // ==========================================
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }
    
    // ==========================================
    // BOOKINGS - User bisa buat, owner bisa lihat miliknya, admin bisa lihat semua
    // ==========================================
    match /bookings/{bookingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if false;
    }
    
    // ==========================================
    // TICKETS - User hanya bisa lihat tiket miliknya
    // ==========================================
    match /tickets/{ticketId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }
    
    // ==========================================
    // CHATS - Hanya peserta chat yang bisa baca/tulis
    // ==========================================
    match /chats/{chatId}/{messages} {
      allow read, write: if request.auth != null;
    }
    
    // ==========================================
    // SPOTS - Semua bisa baca, hanya owner/admin yang bisa edit
    // ==========================================
    match /spots/{spotId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // ==========================================
    // BOOKINGS - by Owner (subcollection)
    // ==========================================
    match /users/{userId}/bookings/{bookingId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}